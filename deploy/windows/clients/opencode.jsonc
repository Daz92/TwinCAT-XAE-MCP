// OpenCode: merge into opencode.jsonc (project) or ~/.config/opencode/opencode.jsonc.
// Replace <host> and <user>. Always name the server "te1000": tool guards match
// that name only. The local variant differs only in "command".
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Remote Windows host over ssh.
    "te1000": {
      "type": "local",
      "command": [
        "ssh", "-T", "-o", "BatchMode=yes", "<host>",
        "powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
        "-File", "C:\\Users\\<user>\\AppData\\Local\\TwinCAT-XAE-MCP\\deploy\\windows\\te1000-mcp-launch.ps1",
        "-Pipe", "te1000"
      ],
      "enabled": true
    }
    // OpenCode running on the Windows host itself - use this "te1000" instead:
    // "te1000": {
    //   "type": "local",
    //   "command": [
    //     "powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
    //     "-File", "C:\\Users\\<user>\\AppData\\Local\\TwinCAT-XAE-MCP\\deploy\\windows\\te1000-mcp-launch.ps1",
    //     "-Pipe", "te1000"
    //   ],
    //   "enabled": true
    // }
  }
}
